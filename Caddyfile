## Set DOMAIN in .env (e.g. DOMAIN=myvpn.ru) — Caddy automatically obtains and
## renews a free Let's Encrypt certificate for it. Falls back to "localhost"
## (no real cert, harmless) if DOMAIN isn't set yet, so Caddy always starts
## cleanly even before a domain is configured.
{$DOMAIN:localhost} {
    reverse_proxy frontend:80
}

## Catch-all for plain HTTP by raw IP (e.g. the Flutter client hitting
## http://<server-ip>:80 directly) — kept working exactly as before, no TLS.
:80 {
    reverse_proxy frontend:80
}
