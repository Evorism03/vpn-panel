# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── First admin (created on startup if no admins exist) ───────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── AWG ───────────────────────────────────────────────────────────────────────
AWG_CONFIG_PATH=./data/awg0.conf
AWG_INTERFACE=awg0
AWG_BIN=awg
AWG_DOCKER_CONTAINER=
AWG_CONTAINER_CONFIG_PATH=/opt/amnezia/awg/awg0.conf
MOCK_AWG=true

# ── Client config defaults ────────────────────────────────────────────────────
SERVER_ENDPOINT=your-server-ip:51820
CLIENT_DNS=1.1.1.1
CLIENT_ALLOWED_IPS=0.0.0.0/0,::/0
CLIENT_PERSISTENT_KEEPALIVE=25

# ── Data paths ────────────────────────────────────────────────────────────────
DATA_DIR=./data
DB_PATH=./data/vpn.db

# ── Lava payments ─────────────────────────────────────────────────────────────
LAVA_API_KEY=
LAVA_SHOP_ID=
LAVA_SUCCESS_URL=http://localhost:5173/cabinet
LAVA_FAIL_URL=http://localhost:5173

# ── Pricing (RUB) ─────────────────────────────────────────────────────────────
PRICE_1M=199
PRICE_3M=499
PRICE_6M=899
PRICE_1Y=1499

# ── Branding ──────────────────────────────────────────────────────────────────
PANEL_NAME=VPN Panel
PANEL_DOMAIN=localhost
