# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── First admin (created on startup if no admins exist) ───────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── AWG ───────────────────────────────────────────────────────────────────────
AWG_CONFIG_PATH=./data/awg0.conf
AWG_INTERFACE=awg0
AWG_BIN=awg
AWG_DOCKER_CONTAINER=
AWG_CONTAINER_CONFIG_PATH=/opt/amnezia/awg/awg0.conf
MOCK_AWG=true

# ── Client config defaults ────────────────────────────────────────────────────
SERVER_ENDPOINT=your-server-ip:51820
CLIENT_DNS=1.1.1.1
CLIENT_ALLOWED_IPS=0.0.0.0/0,::/0
CLIENT_PERSISTENT_KEEPALIVE=25

# ── Data paths ────────────────────────────────────────────────────────────────
DATA_DIR=./data
DB_PATH=./data/vpn.db
RELEASES_DIR=./data/releases

# ── Lava payments ─────────────────────────────────────────────────────────────
LAVA_API_KEY=
LAVA_SHOP_ID=
LAVA_SUCCESS_URL=http://localhost:5173/cabinet
LAVA_FAIL_URL=http://localhost:5173

# ── Pricing (RUB) — set to 0 to hide a term from the shop ────────────────────
PRICE_3D=79
PRICE_7D=129
PRICE_14D=179
PRICE_1M=199
PRICE_3M=499
PRICE_6M=899
PRICE_1Y=1499

# ── SMTP email notifications (leave SMTP_HOST empty to disable) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ── Security: Fernet key for encrypting server tokens in DB ───────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Branding ──────────────────────────────────────────────────────────────────
PANEL_NAME=VPN Panel
PANEL_DOMAIN=localhost

# ── Caddy (reverse proxy + automatic HTTPS) ───────────────────────────────────
# Your real domain, e.g. myvpn.ru — Caddy requests/renews a free Let's Encrypt
# certificate for it automatically. Plain HTTP by IP (port 80) keeps working
# unchanged for the Flutter client, see Caddyfile.
DOMAIN=yourdomain.com
